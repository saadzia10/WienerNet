{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/plot_conventions_reminder.py",
            "statusMessage": "Checking plot conventions..."
          }
        ]
      }
    ]
  }
}
